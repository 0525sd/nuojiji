false,"translation":null,"userId":"uid_1782055845928_hyeor3ki7","characterId":"278dda40-a40d-481c-805c-e26f5cc9ac71","_id":20849},{"id":1787374494448,"text":"？","sender":"me","time":"13:26","timestamp":1787376379283,"replyTo":{"id":1787374494444,"text":"还有，你为什么这么肯定我三十岁还爱你？","sender":"them","isSimulated":false},"userId":"uid_1782055845928_hyeor3ki7","characterId":"278dda40-a40d-481c-805c-e26f5cc9ac71","_id":20850},{"id":1787374494449,"text":"我管你30岁还喜不喜欢呢","sender":"me","time":"13:26","timestamp":1787376400730,"replyTo":null,"userId":"uid_1782055845928_hyeor3ki7","characterId":"278dda40-a40d-481c-805c-e26f5cc9ac71","_id":20851},{"id":1787374494450,"text":"你要是不喜欢我也拍拍屁股就走","sender":"me","time":"13:26","timestamp":1787376414832,"replyTo":null,"userId":"uid_1782055845928_hyeor3ki7","characterId":"278dda40-a40d-481c-805c-e26f5cc9ac71","_id":20852}]